
/*
"logout": {
    "route": "POST /api/auth/logout",
    "body": {
        "refreshToken": "refreshtoken"
    },
    "response": {
        "message": "Logout success"
    }
}
*/

function logout() {
    const body = {
    };

    ajax({
        method: "POST",
        url: `${API_PATH}/`,
        body: body,
        auth: true,
        callbackSuccess: Success,
        callbackError: Error
    });
}

/******************************/
/******************************/
/******************************/

function Success(result) {
    conLog(result);
}

/******************************/
/******************************/
/******************************/

function Error(result) {
    conError(result);
}


